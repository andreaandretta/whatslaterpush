# =============================================================================
# WhatsLater (SchedWhats) — environment variables template
# =============================================================================
# Copy to `.env.local` for local dev or set the same keys in Vercel project
# settings for staging/prod. Every variable that ships in production is
# listed here. `NEXT_PUBLIC_*` keys are exposed to the browser; all others
# are server-only.
# =============================================================================


# --- Supabase --------------------------------------------------------------
# Project URL appears in both the public (browser) and server contexts.
# The server falls back: process.env.SUPABASE_URL || NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...           # anon JWT, browser-safe
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...               # service role, server only


# --- Evolution API (self-hosted Baileys gateway on DigitalOcean droplet) ----
EVOLUTION_API_URL=https://your-evolution.example.com
EVOLUTION_API_KEY=                                    # generated in evolution-config.json


# --- App base URL (used in Stripe checkout success/cancel + WA links) ------
NEXT_PUBLIC_APP_URL=https://whatslaterpush.vercel.app


# --- LLM parsing (webhook self-chat backend) -------------------------------
# Groq is primary (free tier), OpenAI is automatic fallback when Groq fails
# or returns null. Both must be set for production resilience.
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...


# --- Stripe ----------------------------------------------------------------
# Stripe live mode is currently DEFERRED (SCARTATA 2026-05-17): the first 5
# paying users are handled via manual bonifico/PayPal. Set sandbox keys here
# until ~5 paying users are onboarded.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                       # from `stripe listen` or dashboard

# Price IDs for the 3 paid tiers. Must exist in the same Stripe account as
# STRIPE_SECRET_KEY above. See app/lib/plans.ts for the corresponding limits.
STRIPE_PRICE_PERSONAL=price_...                       # EUR 4,99 / mese
STRIPE_PRICE_PROFESSIONAL=price_...                   # EUR 9,99 / mese
STRIPE_PRICE_BUSINESS=price_...                       # EUR 19,99 / mese


# --- Internal secrets (rotate regularly) -----------------------------------
# Cookie HMAC for the C1 phone-first auth (sessions in pending_auth_sessions).
# Generate with: openssl rand -hex 64
AUTH_COOKIE_SECRET=

# Shared secret on every Evolution -> /api/webhook POST. Set the same value
# in the Evolution instance config.
WEBHOOK_SECRET=

# Cron-job.org pings /api/cron/send-messages every 5 min with this in the
# Authorization header. Also used by /api/admin/* manual ops endpoints.
CRON_SECRET=

# Bearer for /api/monitoring/health-check (external uptime monitor).
MONITORING_SECRET=

# Token for the destructive DELETE on /api/debug-logs (clears the webhook_logs
# table). Set to a random 32+ char string. A deprecated hardcoded token still
# works until 2026-06-03 — any caller using it triggers a WARN log so we can
# spot orphan scripts before the cutover.
DEBUG_LOGS_SECRET=


# --- Admin (operator) ------------------------------------------------------
# /api/cron/daily-report sends the daily summary to this WA number only.
# Also referenced by alert routing in app/lib/monitoring.ts.
# Format: country code + national number, no leading "+" or spaces
# (e.g. an Italian mobile becomes 39 followed by the 10-digit number).
ADMIN_PHONE=39XXXXXXXXXX
ADMIN_EMAIL=admin@example.com


# --- DigitalOcean droplet metrics (read by /api/admin/droplet) -------------
DO_API_TOKEN=dop_v1_...
DO_DROPLET_ID=


# --- Email alerts (Resend) -------------------------------------------------
# Used by app/lib/monitoring.ts to send operator alerts when WA channel
# is unavailable. Optional — alerts gracefully no-op when unset.
RESEND_API_KEY=re_...


# --- Operational flag ------------------------------------------------------
# Read by next.config.js `env` block and exposed to the runtime. Set to
# 'maintenance' to render a static notice in place of the dashboard
# during planned downtime. Defaults to 'active' when unset.
SYSTEM_STATUS=active
